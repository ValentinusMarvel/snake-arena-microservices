        },
        {
          "name": "4.7 PATCH Activate Tactical Skill (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Skill is active\", () => pm.expect(pm.response.json().skillActive).to.eql(true));"
