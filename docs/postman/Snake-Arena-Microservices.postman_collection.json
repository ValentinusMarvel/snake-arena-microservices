    {
      "name": "03 - Player Service API v2 (Breaking Change & Modern RPG)",
      "item": [
        {
          "name": "3.1 NEGATIVE TEST: Kirim Payload v1 Flat ke v2 (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Breaking change enforced: 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "const err = pm.response.json();",
                  "pm.test(\"Error follows HttpErrorInfo schema with serviceAddress\", () => {",
                  "    pm.expect(err.status).to.eql(400);",
                  "    pm.expect(err.serviceAddress).to.be.a(\"string\");",
                  "    pm.expect(err.invalidFields).to.have.property(\"classProfile\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"LegacyClient\",\n  \"snakeType\": \"VIPER\"\n}"
            },
            "url": "{{player_url}}/api/v2/players"
          }
        },
        {
          "name": "3.2 NEGATIVE TEST: className Tidak Valid DRAGON (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Unknown class rejected with 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "const err = pm.response.json();",
                  "pm.test(\"invalidFields specifies classProfile.className\", () => {",
                  "    pm.expect(err.invalidFields).to.have.property(\"classProfile.className\");",
                  "});"
                ],
                "type": "text/javascript"
