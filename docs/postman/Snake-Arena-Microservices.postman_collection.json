    {
      "name": "04 - Arena Service & Inter-Service Score Sync",
      "description": "Catatan Demo Manual: Arena memiliki watchdog timeout 7 detik jika tidak menerima heartbeat. Jalankan folder ini berurutan lewat Runner atau klik berurutan dalam < 7 detik per langkah (atau klik PATCH heartbeat untuk memperpanjang sesi).",
      "item": [
        {
          "name": "4.1 POST Join Arena (Spawn Snake - 201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Snake spawned with 201 Created\", () => pm.response.to.have.status(201));",
                  "const snake = pm.response.json();",
                  "pm.test(\"Valid snake ID stored\", () => {",
                  "    pm.expect(snake.id).to.match(/^SNK-/);",
                  "    pm.collectionVariables.set(\"snake_id\", snake.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{player_id_v1}}\",\n  \"playerName\": \"{{demo_player_name}}\",\n  \"snakeType\": \"COBRA\",\n  \"color\": \"#ffd700\"\n}"
            },
            "url": "{{arena_url}}/api/v1/arena/snakes"
          }
        },
        {
          "name": "4.2 GET Arena State Snapshot 30x30 (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const state = pm.response.json();",
                  "pm.test(\"Grid dimensions are 30x30 with active apples\", () => {",
                  "    pm.expect(state.gridWidth).to.eql(30);",
                  "    pm.expect(state.gridHeight).to.eql(30);",
                  "    pm.expect(state.maxPlayers).to.eql(16);",
                  "    if (state.apples && state.apples.length > 0) {",
                  "        pm.collectionVariables.set(\"apple_id\", state.apples[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{arena_url}}/api/v1/arena/state"
          }
        },
        {
          "name": "4.3 GET Snake Telemetry by ID (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const snake = pm.response.json();",
                  "pm.test(\"Snake is alive\", () => pm.expect(snake.alive).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{arena_url}}/api/v1/arena/snakes/{{snake_id}}"
          }
        },
        {
          "name": "4.4 PUT Update In-Game Loadout (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const snake = pm.response.json();",
                  "pm.test(\"Loadout changed to PYTHON\", () => pm.expect(snake.snakeType).to.eql(\"PYTHON\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"snakeType\": \"PYTHON\",\n  \"color\": \"#00d4ff\"\n}"
            },
            "url": "{{arena_url}}/api/v1/arena/snakes/{{snake_id}}/loadout"
          }
        },
        {
          "name": "4.5 PATCH Change Direction LEFT (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Direction updated to LEFT\", () => pm.expect(pm.response.json().direction).to.eql(\"LEFT\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{arena_url}}/api/v1/arena/snakes/{{snake_id}}/direction?dir=LEFT",
              "host": ["{{arena_url}}"],
              "path": ["api", "v1", "arena", "snakes", "{{snake_id}}", "direction"],
              "query": [{ "key": "dir", "value": "LEFT" }]
            }
          }
        },
        {
          "name": "4.6 PATCH Eat Apple (Grow & Add Score)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const snake = pm.response.json();",
                  "pm.test(\"Snake score increased after eating apple\", () => pm.expect(snake.score).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
