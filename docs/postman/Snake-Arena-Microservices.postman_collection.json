            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"InvalidClassUser\",\n  \"classProfile\": {\n    \"className\": \"DRAGON\",\n    \"passiveEffect\": \"FIRE\",\n    \"activeAbility\": {\n      \"name\": \"Flame Breath\",\n      \"cooldownSeconds\": 5,\n      \"speedMultiplier\": 1.5\n    }\n  }\n}"
