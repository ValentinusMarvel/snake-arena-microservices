    {
      "name": "02 - Player Service API v1 (Legacy Flat)",
      "item": [
        {
          "name": "2.1 POST Create Player v1 (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Valid v1 flat fields (snakeType & speed)\", () => {",
                  "    pm.expect(json.id).to.match(/^PL-/);",
                  "    pm.expect(json.snakeType).to.eql(\"VIPER\");",
                  "    pm.expect(json.speed).to.eql(7);",
                  "    pm.collectionVariables.set(\"player_id_v1\", json.id);",
                  "    pm.collectionVariables.set(\"demo_player_name\", json.username);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ViperDemo_{{$randomInt}}\",\n  \"snakeType\": \"VIPER\"\n}"
            },
            "url": "{{player_url}}/api/v1/players"
