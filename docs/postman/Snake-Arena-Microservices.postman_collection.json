            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ViperRPG_{{$randomInt}}\",\n  \"classProfile\": {\n    \"className\": \"VIPER\",\n    \"passiveEffect\": \"POISON_TRAIL\",\n    \"activeAbility\": {\n      \"name\": \"Venom Dash\",\n      \"cooldownSeconds\": 5,\n      \"speedMultiplier\": 1.8\n    }\n  }\n}"
            },
            "url": "{{player_url}}/api/v2/players"
