          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{arena_url}}/api/v1/arena/snakes/{{snake_id}}/skill?active=true",
              "host": ["{{arena_url}}"],
              "path": ["api", "v1", "arena", "snakes", "{{snake_id}}", "skill"],
              "query": [{ "key": "active", "value": "true" }]
            }
          }
        },
        {
          "name": "4.8 PATCH Heartbeat Keepalive (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));"
                ],
